// Grafana Alloy: discovers Docker containers running on the same host,
// scrapes stdout/stderr from each via the Docker socket, and ships log lines
// to Loki with container.name + compose service.name as labels.

logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Map Docker labels onto Loki labels. The container name (with leading
// slash stripped) becomes the `container` label; the compose service name
// becomes the `service` label, which is what tracesToLogsV2 in Grafana
// uses to filter logs by service when you click a span.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = { job = "docker" }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
