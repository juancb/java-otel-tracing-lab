// k8s-adapted Alloy config for the Cilium lab.
// Differences from /alloy/config.alloy (Compose version):
//   - Uses Kubernetes pod discovery instead of the Docker socket.
//   - Maps the pod label `app=` to the `service` Loki label so the existing
//     Grafana derived-fields config (service=...) keeps working.

logging {
  level  = "info"
  format = "logfmt"
}

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  // Carry the pod's `app` label into Loki as `service`.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
