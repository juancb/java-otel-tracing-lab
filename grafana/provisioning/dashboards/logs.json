{
  "annotations": {"list": []},
  "description": "Stage C: live log tail across all services in the lab. Click any traceId in a log line to jump to the trace in Tempo. Click any service in the legend to filter.",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "tags": [],
      "title": "Service map",
      "type": "link",
      "url": "/d/otel-lab-service-map/otel-lab-service-map-red"
    }
  ],
  "liveNow": true,
  "panels": [
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "All log lines, sorted newest-first. Use the variable filters to narrow by service.",
      "gridPos": {"h": 24, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "{service=~\"$service\"}",
        "refId": "A"
      }],
      "title": "All logs - $service",
      "type": "logs"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["otel", "stage-c", "logs"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values(service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
  "title": "OTel Lab - logs",
  "uid": "otel-lab-logs",
  "version": 1
}
