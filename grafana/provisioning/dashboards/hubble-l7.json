{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Kafka topic observability via OTel span-metrics + Hubble HTTP L7 for Jetty UIs. Part of the Kubernetes + Cilium production track (K-3).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Service map",
      "url": "/d/otel-lab-service-map",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "JMX",
      "url": "/d/otel-lab-jmx",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Kafka — OTel span-metrics (topic from Java agent)",
      "type": "row"
    },
    {
      "type": "text",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "mode": "markdown",
        "content": "**Source:** `traces_spanmetrics_*` generated by Tempo's `span-metrics` processor from every span the OTel Collector processes. The OTel Java agent instruments `KafkaProducer.send()` with the topic name in the span name (e.g. `sensor.readings publish`). Cilium Kafka L7 enforcement via `role: produce/consume` was removed in Cilium 1.20 (proxylib removal, [PR #43557](https://github.com/cilium/cilium/pull/43557)) — the Java agent is the correct source for Kafka topic observability."
      },
      "title": ""
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(traces_spanmetrics_calls_total{service=\"producer\"}[2m])",
          "legendFormat": "produce ({{span_name}})",
          "refId": "A"
        }
      ],
      "title": "Kafka produce rate (producer → sensor.readings)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s",
          "decimals": 2
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(traces_spanmetrics_latency_bucket{service=\"producer\"}[2m]))",
          "legendFormat": "p50 produce",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(traces_spanmetrics_latency_bucket{service=\"producer\"}[2m]))",
          "legendFormat": "p99 produce",
          "refId": "B"
        }
      ],
      "title": "Kafka produce latency (p50 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(traces_spanmetrics_calls_total{service=\"consumer\"}[2m])",
          "legendFormat": "consumer ({{span_name}})",
          "refId": "A"
        }
      ],
      "title": "Consumer spans (Kafka poll → HBase Put)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(traces_spanmetrics_calls_total{service=\"query-client\"}[2m])",
          "legendFormat": "query-client ({{span_name}})",
          "refId": "A"
        }
      ],
      "title": "Query-client spans (Scan / Get / Increment)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "id": 7,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"producer|consumer|query-client\", status_code=\"STATUS_CODE_ERROR\"}[5m]))",
          "legendFormat": "errors/s",
          "refId": "A"
        }
      ],
      "title": "Kafka service error rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
      "id": 8,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "expr": "rate(traces_spanmetrics_calls_total{service=\"producer\"}[2m])",
          "legendFormat": "produce/s",
          "refId": "A"
        }
      ],
      "title": "Produce rate",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 10,
      "title": "Hubble HTTP L7 — Jetty management UIs",
      "type": "row"
    },
    {
      "type": "text",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 25 },
      "id": 11,
      "options": {
        "mode": "markdown",
        "content": "**Source:** `hubble_http_*` metrics from Cilium's Hubble HTTP L7 filter (K-3 policy: `http-namenode`, `http-hbase-master`, `http-hbase-regionserver`). These give an independent network-layer view of the same Jetty HTTP traffic the OTel Java agent captures as SERVER spans. Panels populate after `cilium upgrade` enables `prometheus.enabled: true` in the agent.\n\nIf panels show no data, run: `kubectl --context kind-otel-lab exec -n kube-system daemonset/cilium -- curl -s localhost:9962/metrics | grep hubble_http`"
      },
      "title": ""
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "id": 12,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (source_workload, verdict) (rate(hubble_http_requests_total{destination_port=\"9870\"}[2m]))",
          "legendFormat": "{{source_workload}} → NN:9870 [{{verdict}}]",
          "refId": "A"
        }
      ],
      "title": "NameNode Jetty (:9870) requests/s",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "id": 13,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (source_workload, destination_port, verdict) (rate(hubble_http_requests_total{destination_port=~\"16010|16030\"}[2m]))",
          "legendFormat": "{{source_workload}} → HBase:{{destination_port}} [{{verdict}}]",
          "refId": "A"
        }
      ],
      "title": "HBase Jetty UIs (:16010 master / :16030 RS) requests/s",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s",
          "decimals": 3
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "id": 14,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(hubble_http_request_duration_seconds_sum{destination_port=~\"9870|16010|16030\"}[2m]) / rate(hubble_http_request_duration_seconds_count{destination_port=~\"9870|16010|16030\"}[2m])",
          "legendFormat": "avg latency :{{destination_port}}",
          "refId": "A"
        }
      ],
      "title": "Jetty UI average response time",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["k8s", "cilium", "hubble", "kafka", "otel"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource",
        "label": "Prometheus"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "OTel Lab — Hubble L7",
  "uid": "otel-lab-hubble-l7",
  "version": 1
}
