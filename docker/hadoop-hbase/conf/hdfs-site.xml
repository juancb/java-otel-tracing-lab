<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>

  <property>
    <name>dfs.namenode.name.dir</name>
    <value>/data/dfs/name</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>/data/dfs/data</value>
  </property>

  <!--
    KEY FIX: rpc-address is what *clients and DataNodes dial*. It must be the
    hostname they can resolve, NOT 0.0.0.0. Use rpc-bind-host=0.0.0.0
    separately to make the NameNode bind on all interfaces.
  -->
  <property>
    <name>dfs.namenode.rpc-address</name>
    <value>namenode:8020</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-bind-host</name>
    <value>0.0.0.0</value>
  </property>

  <property>
    <name>dfs.namenode.http-address</name>
    <value>namenode:9870</value>
  </property>
  <property>
    <name>dfs.namenode.http-bind-host</name>
    <value>0.0.0.0</value>
  </property>

  <!-- Service-RPC port (used for DN reports). Same split. -->
  <property>
    <name>dfs.namenode.servicerpc-bind-host</name>
    <value>0.0.0.0</value>
  </property>

  <property>
    <name>dfs.datanode.use.datanode.hostname</name>
    <value>true</value>
  </property>
  <property>
    <name>dfs.client.use.datanode.hostname</name>
    <value>true</value>
  </property>

  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>

  <!-- Single-node lab setup: lower safemode threshold from 0.999 to 0.5 -->
  <!-- (blocks in: 0.5*total >= min_datanodes) -->
  <property>
    <name>dfs.namenode.safemode.threshold-pct</name>
    <value>0.5</value>
  </property>
  <!-- Don't wait 30s after minimum threshold is met -->
  <property>
    <name>dfs.namenode.safemode.extension</name>
    <value>0</value>
  </property>

  <!--
    Latency percentiles (golden-signals work). Hadoop computes NO percentile
    metrics by default; every RPC/HDFS latency is only an average until these
    are set. Each interval N adds rolling-window quantile gauges (50/75/90/95/99)
    named like RpcQueueTime60s99thPercentileLatency to the metrics2 records, so
    they show up in /jmx, /prom and the JMX exporter alike.
  -->
  <!-- RPC server: RpcQueueTime / RpcProcessingTime / RpcLockWaitTime quantiles
       (NameNode :8020 and DataNode IPC :9867). -->
  <property>
    <name>rpc.metrics.quantile.enable</name>
    <value>true</value>
  </property>
  <property>
    <name>rpc.metrics.percentiles.intervals</name>
    <value>60</value>
  </property>
  <!-- HDFS: NameNode edit-log Syncs, DataNode PacketAckRoundTripTimeNanos,
       FlushNanos, FsyncNanos, SendDataPacket*Nanos, and (with profiling
       below) per-volume file-IO latencies. -->
  <property>
    <name>dfs.metrics.percentiles.intervals</name>
    <value>60</value>
  </property>
  <!-- Profile every DataNode file IO so DataNodeVolume reports read/write/
       sync latency quantiles and IO error counts. Lab setting: in production
       sample a few percent. -->
  <property>
    <name>dfs.datanode.fileio.profiling.sampling.percentage</name>
    <value>100</value>
  </property>
</configuration>
